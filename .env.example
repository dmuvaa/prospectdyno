NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI
OPENAI_API_KEY=

# Discovery
APIFY_API_TOKEN=
APIFY_GOOGLE_MAPS_ACTOR_ID=compass/crawler-google-places
APIFY_CONTACT_ACTOR_ID=lukaskrivka/google-maps-with-contact-details
APIFY_WEBSITE_CRAWLER_ACTOR_ID=apify/website-content-crawler
APIFY_SERP_ACTOR_ID=apify/google-search-scraper
APIFY_REVIEWS_ACTOR_ID=compass/google-maps-reviews-scraper

# Queue / workers
# Render background worker Environment tab needs:
#   NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#   OPENAI_API_KEY
#   REDIS_URL  (internal URL from the Render Redis instance, worker only)
# Do not set REDIS_URL on Vercel (Vercel cannot reach Render private Redis).
REDIS_URL=
WORKER_SECRET=
# Optional. Only needed if a public HTTP worker exists.
WORKER_URL=
